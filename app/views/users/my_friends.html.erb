<div id="flash_messages">
</div>

<h1>Friends</h1>

<div class="search-area">
    <h3>Search Friends</h3>
    <%= form_with url: search_friend_path(format: :turbo_stream), method: :get do %>
      <div class="form-group row">
          <div class="col-sm-9 no-right-padding">
              <%= text_field_tag :friend, params[:friend], placeholder: "Name or email", autofocus: true, class: "form-control form-control-lg" %>
          </div>
          <div class="col-sm-3 no-left-padding">
              <%= button_tag type: :submit, class: "btn btn-success" do %>
                <!-- https://www.rubydoc.info/gems/fontawesome_icons_rails -->
                <!-- prendre la bonne version font awesome et mettre les fichiers de font dans public/webfonts-->
                <%= fa_icon('magnifying-glass', type: :solid, size: '2x') %>
            <% end %>
          </div>
      </div>
    <% end %>
</div>
<%= turbo_frame_tag "friend_result" do %>
    <%= render "users/friend_result", friends: @friends %>
<% end %>

<% if !@friends.empty? %>
    <%= render 'friends/list'%>
<% end %>
